# =============================================================================
# BizFlow Environment Variables — Template
# =============================================================================
# Copy this file to .env.dev or .env.prod and fill in the real values.
# NEVER commit .env.dev or .env.prod to Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development          # or Production

# ---------------------------------------------------------------------------
# Database
# DEV:  points to the local mysql container (Server=mysql;...;SslMode=none)
# PROD: points to Aiven hosted MySQL       (Server=xxx.aivencloud.com;...;SslMode=Required)
# ---------------------------------------------------------------------------
DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=bizflow_db;User=admin;Password=admin;CharSet=utf8mb4;SslMode=none;

# Local MySQL (dev only — not used in production)
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=bizflow_db
MYSQL_USER=admin
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3307

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=your_secret_key_at_least_32_characters_long
JWT_ISSUER=BizFlow
JWT_AUDIENCE=BizFlowUsers
JWT_ACCESS_EXPIRY_MINUTES=5
JWT_REFRESH_EXPIRY_DAYS=365

# ---------------------------------------------------------------------------
# Google OAuth 2.0
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------------------------------------------------------------------------
# Cloudinary (Image Storage & CDN)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------------------------------------------------------------------------
# Firebase FCM (Push Notifications)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id

# ---------------------------------------------------------------------------
# Stripe (Subscription Payment)
# DEV:  use test key  sk_test_...
# PROD: use live key  sk_live_...
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# ---------------------------------------------------------------------------
# AI Service (Python)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-stt.json