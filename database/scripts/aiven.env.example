# Copy this file to aiven.env and fill with your Aiven credentials.
# Do not commit aiven.env.

AIVEN_DB_HOST=your-service.aivencloud.com
AIVEN_DB_PORT=12345
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=replace_me
AIVEN_DB_SSL_MODE=REQUIRED
# Optional: absolute path to CA certificate (for VERIFY_CA / VERIFY_IDENTITY)
AIVEN_DB_SSL_CA=
# Optional: absolute path to mysql.exe (if PATH is not configured)
AIVEN_MYSQL_CLIENT_PATH=
