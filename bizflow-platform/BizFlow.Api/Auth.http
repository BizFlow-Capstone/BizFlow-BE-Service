@host = https://localhost:7270
@contentType = application/json

# ================================================================
# AUTH FLOW TEST
# ================================================================
# Test order:
#   1. Google Login  → get accessToken + refreshToken
#   2. Get Credentials → verify credential list
#   3. Set Password  → set password for Google account
#   4. Refresh Token → rotate refresh token
#   5. Logout        → revoke refresh token
# ================================================================

# -------------------- VARIABLES --------------------
# After Google Login, copy tokens here:
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..yKp37U43_ysj-WuDpOcLR38pqvKUFAu6eR10GSA74yg
@refreshToken = qVQKYbAeClP47EKEy9jMtEmRY2KOALU25dX+G2NLxOU=
# After forgot-password/verify-otp; has "purpose":"password_reset" — use only for forgot-password/reset
@resetAccessToken = paste_token_from_otp_verify_here


### ====================================================
### 1. GOOGLE LOGIN
### ====================================================
### How to get idToken:
###   - Open docs/test-google-login.html in browser
###   - Sign in with Google
###   - Copy the ID Token
### ====================================================
POST {{host}}/api/auth/google
Content-Type: {{contentType}}

{
    "idToken": "eyJhbGciOiJSUzI1NiIsImtpZCI6IjUzMDcyNGQ0OTE3M2EzZWQ2YjRhMDBhYTYzNDQyMDMwMGQ3MmFlNWIiLCJ0eXAiOiJKV1QifQ..Ayegjm1pBVUIG3MzOEqS9yd4DoDjNFuiPbLzd2-ih84Esg33HinVpH4Dof2uOQIYDn66Tijjp-9R6YXujMqhM-AZmXVd3thXZlOCp9-06eahdwxI_29MgUDIkGdu50Nlwdy3fB2sb_awa5yf5Vvio79eZ2QL7NNX8apnaq03sAqRentW__HfakKOIaJKs1afZZ_fweCbIUUqMIHeTKz9t5DL41XkIF3CVIGpbdTW_uum1sIX2PAQyNLdsijgt09zqplOs3JiTqJPd8CDgdymaLptmIm4BCFgefua-CD9TFt7whd2w7zFWCMKcvKzh3MPDcbGuklRJQwhq-q_k8VEew",
    "deviceInfo": "VS Code REST Client"
}

### ====================================================
### 1.0.1 LINK PHONE TO EXISTING ACCOUNT (Firebase OTP)
### ====================================================
### Requires accessToken from an existing logged-in account.
### If account has no password yet (Google-only), pass password to set it.
### ====================================================
POST {{host}}/api/auth/link/phone
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
    "phone": "0363053659",
    "firebaseIdToken": "eyJhbGciOiJSUzI1NiIsImtpZCI6ImEyZGZiOGEzOGI1MmQ5ZjA5ZWRjYWE1MDcwYTBlOGYwYTllMDk4YmEiLCJ0eXAiOiJKV1QifQ..KmzxzHkbNu0XN5upVrgLfu2dmIDikmvON5CG9_yxeSCChy4zUf0Sm3dBd-942YMd1JdDDPljAuBGnDbeI0k5gd3TSjVfAgqfGIJNyGBcJA5Sz-vhi1mhWRnLxc6aymlN1xA0YWGGkVPRk1hJpJp2sXzxrP8NFUAQCAJCCu4YFDaGtZYFuqbOvgq64DCgWA7B7JCOrPFuk9mm-4hvTxHclAN8iULCxSnQCft6YNyHGgNpPf4mQBY4hV_JnQpL1B6-Lmw8tm7c2luoX-PnbWIE8q7PCY-5YW2QFbDng73hhmSQ1oQM92cVyTn-v_clNgGDYhAx9jXfGNmiSUauYOoRmQ",
    "password": "MySecureP@ssw0rd123"
}

### ====================================================
### FORGOT PASSWORD (email OTP)
### ====================================================
### 1) send-otp → 2) verify-otp (accessToken, no refresh) →
### 3) reset (Bearer password-reset token only).
### Password-reset JWT cannot call other protected APIs (403).
### ====================================================
POST {{host}}/api/auth/forgot-password/send-otp
Content-Type: {{contentType}}

{
    "email": "user@example.com"
}

POST {{host}}/api/auth/forgot-password/verify-otp
Content-Type: {{contentType}}

{
    "email": "user@example.com",
    "otpCode": "123456"
}

POST {{host}}/api/auth/forgot-password/reset
Authorization: Bearer {{resetAccessToken}}
Content-Type: {{contentType}}

{
    "password": "NewSecureP@ssw0rd123"
}

### ====================================================
### 1.1 LOGIN WITH EMAIL + PASSWORD
### ====================================================
POST {{host}}/api/auth/login/email
Content-Type: {{contentType}}

{
    "email": "lmt30180504@gmail.com",
    "password": "MySecureP@ssw0rd123",
    "deviceInfo": "VS Code REST Client"
}

### ====================================================
### 1.2 LOGIN WITH PHONE + PASSWORD
### ====================================================
POST {{host}}/api/auth/login/phone
Content-Type: {{contentType}}
{
    "phone": "0901234567",
    "password": "123456",
    "deviceInfo": "VS Code REST Client"
}

### ====================================================
### 2. GET CREDENTIALS (requires auth)
### ====================================================
GET {{host}}/api/auth/credentials
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### ====================================================
### 3. SET PASSWORD (requires auth)
### ====================================================
### Sets password for Google-only account.
### Also auto-creates email credential from Google email.
### ====================================================
POST {{host}}/api/auth/set-password
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
    "password": "MySecureP@ssw0rd123"
}

### ====================================================
### 4. REFRESH TOKEN (public)
### ====================================================
### Use the refreshToken from Google Login response.
### Returns new accessToken + new refreshToken (rotation).
### ====================================================
POST {{host}}/api/auth/refresh
Content-Type: {{contentType}}

{
    "refreshToken": "{{refreshToken}}",
    "deviceInfo": "VS Code REST Client"
}

### ====================================================
### 5. LOGOUT (requires auth)
### ====================================================
### Revokes the refresh token (single session logout).
### ====================================================
POST {{host}}/api/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
    "refreshToken": "{{refreshToken}}"
}

### ====================================================
### 5.1 LOGOUT ALL DEVICES (requires auth)
### ====================================================
POST {{host}}/api/auth/logout-all
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### ====================================================
### 6. VERIFY TOKEN EXPIRED (after logout)
### ====================================================
### After logout, the old refresh token should fail.
### Expected: 401 Unauthorized
### ====================================================
POST {{host}}/api/auth/refresh
Content-Type: {{contentType}}

{
    "refreshToken": "{{refreshToken}}",
    "deviceInfo": "VS Code REST Client"
}
